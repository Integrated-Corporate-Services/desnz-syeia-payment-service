{
  "name": "inbound-event-receiver",
  "version": "1.0.0",
  "description": "Microservice for handling webhook integrations from GOV.UK Pay and GOV.UK Notify",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "test": "jest",
    "test:unit": "jest --config jest.config.unit.js",
    "test:integration": "jest --config jest.config.integration.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "joi": "^18.2.3",
    "pg": "^8.20.0",
    "uuid": "^11.1.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.0",
    "@types/joi": "^17.2.2",
    "@types/node": "^18.19.130",
    "@types/pg": "^8.10.0",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "form-data": ">=4.0.6",
    "brace-expansion": ">=5.0.8",
    "js-yaml": ">=4.3.0",
    "body-parser": "^1.20.6"
  },
  "comments": {
    "overrides": "Security fix overrides: body-parser constrained to 1.x for Express compatibility. brace-expansion and js-yaml require major version upgrades as no patched versions exist in old majors. Test tooling (Jest, minimatch) functions correctly with these versions despite semver incompatibility warnings."
  },
  "keywords": [
    "webhook",
    "govuk-pay",
    "govuk-notify",
    "microservice",
    "payments"
  ],
  "author": "DESNZ SYEIA Team",
  "license": "MIT"
}
