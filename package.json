{
  "name": "inbound-event-receiver",
  "version": "1.0.0",
  "description": "Dedicated microservice for handling integrations and webhooks from GOV.UK Pay and GOV.UK Notify for DESNZ-SYEIA",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --config=jest.config.unit.js",
    "test:unit:coverage": "jest --config=jest.config.unit.js --coverage",
    "test:integration": "jest --config=jest.config.integration.js",
    "build": "tsc && copyfiles -u 1 \"src/**/*.js\" dist/",
    "lint": "eslint src/",
    "dev": "nodemon src/server.ts",
    "start": "node dist/server.js",
    "check:lint": "eslint .",
    "check:pretty": "prettier --check \"**/*.{js,ts,json}\"",
    "check": "npm run check:lint && npm run check:pretty",
    "fix:lint": "eslint . --fix",
    "fix:pretty": "prettier --write \"**/*.{js,ts,json}\"",
    "fix": "npm run fix:lint && npm run fix:pretty"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "printWidth": 100
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1034.0",
    "axios": "^1.6.2",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "pg": "^8.11.2",
    "pg-pool": "^3.6.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.7",
    "@types/node": "^20.8.0",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "copyfiles": "^2.4.1",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
