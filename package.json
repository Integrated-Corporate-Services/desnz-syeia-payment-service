{
  "name": "inbound-event-receiver",
  "version": "1.0.0",
  "description": "Microservice for handling webhook integrations from GOV.UK Pay and GOV.UK Notify",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "test": "jest",
    "test:unit": "jest --config jest.config.unit.js",
    "test:integration": "jest --config jest.config.integration.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "pg": "^8.20.0",
    "express": "^4.18.2",
    "uuid": "^9.0.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.16.0",
    "@types/pg": "^8.10.0",
    "@types/uuid": "^9.0.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  },
  "keywords": [
    "webhook",
    "govuk-pay",
    "govuk-notify",
    "microservice",
    "payments"
  ],
  "author": "DESNZ SYEIA Team",
  "license": "ISC"
}
