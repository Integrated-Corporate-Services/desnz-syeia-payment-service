{
  "name": "inbound-event-receiver",
  "version": "1.0.0",
  "description": "Microservice for handling webhook integrations from GOV.UK Pay and GOV.UK Notify",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "test": "jest",
    "test:unit": "jest --config jest.config.unit.js",
    "test:integration": "jest --config jest.config.integration.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "dotenv": "^16.0.3",
    "express": "^4.22.3",
    "express-rate-limit": "^8.6.0",
    "joi": "^18.3.2",
    "pg": "^8.20.0",
    "uuid": "^11.1.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.0",
    "@types/joi": "^17.2.2",
    "@types/node": "^18.19.130",
    "@types/pg": "^8.10.0",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "form-data": ">=4.0.6",
    "brace-expansion": ">=5.0.9",
    "js-yaml": ">=5.4.1",
    "body-parser": "^1.20.9",
    "proxy-addr": ">=2.0.8",
    "ip-address": ">=10.7.4",
    "handlebars": ">=4.7.10",
    "browserslist": ">=4.28.7",
    "baseline-browser-mapping": ">=2.11.0",
    "fast-xml-parser": ">=5.12.0"
  },
  "comments": {
    "overrides": "Security fix overrides: body-parser constrained to 1.x (^1.20.9) for Express 4 compatibility. Existing form-data (>=4.0.6) and brace-expansion (>=5.0.9) overrides are kept. js-yaml is tightened to >=5.4.1 (already on 5.x). Additional overrides pin patched transitive versions: proxy-addr (>=2.0.8), ip-address (>=10.7.4), handlebars (>=4.7.10), browserslist (>=4.28.7), baseline-browser-mapping (>=2.11.0), and fast-xml-parser (>=5.12.0). Test tooling (Jest, minimatch) functions correctly with brace-expansion 5.x despite semver incompatibility warnings."
  },
  "keywords": [
    "webhook",
    "govuk-pay",
    "govuk-notify",
    "microservice",
    "payments"
  ],
  "author": "DESNZ SYEIA Team",
  "license": "MIT"
}
