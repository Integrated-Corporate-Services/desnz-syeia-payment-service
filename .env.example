# Environment Configuration Template
# Copy this file to .env and update with your actual values

# ==========================================
# Server Configuration
# ==========================================
NODE_ENV=local
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug

# Server timeouts (milliseconds)
SERVER_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=35000
REQUEST_TIMEOUT=25000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ==========================================
# Database Configuration
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Database pool settings
DB_POOL_MAX=10
DB_IDLE_MS=20000
DB_CONN_MS=15000
DB_QUERY_MS=40000

# SSL Mode: disable (local) | require (production)
PGSSLMODE=disable

DB_APPLICATION_NAME=inbound-event-receiver

# ==========================================
# GOV.UK Pay Configuration
# ==========================================
GOVPAY_API_URL=https://publicapi.payments.service.gov.uk/v1/payments
GOVPAY_API_KEY=your_govpay_api_key_here
GOVPAY_WEBHOOK_SIGNING_KEY=your_webhook_signing_key_here
GOVPAY_TIMEOUT=10000

# ==========================================
# Webhook Configuration
# ==========================================
WEBHOOK_SIGNING_ALGORITHM=sha256
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_INTERVAL_1=300000
WEBHOOK_RETRY_INTERVAL_2=600000
WEBHOOK_RETRY_INTERVAL_3=900000

# ==========================================
# Backend Service Configuration
# ==========================================
BACKEND_SERVICE_URL=http://localhost:3000/backend
BACKEND_TIMEOUT=5000
BACKEND_RETRY_ATTEMPTS=2
BACKEND_RETRY_DELAY=1000

# ==========================================
# AWS Configuration (Optional)
# ==========================================
AWS_REGION=eu-west-2
AWS_ENDPOINT=
PAYMENT_WEBHOOK_QUEUE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_ENABLED=false

# ==========================================
# Feature Flags
# ==========================================
CALLBACK_SERVICE_ENABLED=true
RETRY_ENABLED=true
DLQ_ENABLED=true
SIGNATURE_VERIFICATION_ENABLED=true
METRICS_ENABLED=false
DETAILED_LOGGING=true

# ==========================================
# Security Configuration
# ==========================================
SESSION_SECRET=change_this_to_a_secure_random_string_in_production
CORS_ORIGINS=*
TRUSTED_PROXIES=
