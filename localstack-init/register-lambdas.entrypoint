#!/bin/sh
set -e

AWS="aws --endpoint-url $AWS_ENDPOINT_URL --region $AWS_DEFAULT_REGION"

echo ""
echo "DESNZ-SYEIA Lambda Register"
echo "pay-callback-reconciler  +  pay-callback-relay"

echo ""
echo "[1/8] Creating shared Lambda IAM execution role..."
$AWS iam create-role \
  --role-name lambda-exec-role \
  --assume-role-policy-document \
    '{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Service":"lambda.amazonaws.com"},"Action":"sts:AssumeRole"}]}' \
  > /dev/null 2>&1 || echo "   (role already exists — skipping)"
echo "IAM role ready."

echo ""
echo "desnz-syeia-pay-callback-reconciler"

echo "[2/8] Building reconciler Lambda ZIP..."
cp -r /lambda-src/reconciler /tmp/reconciler-build
cd /tmp/reconciler-build
npm install --omit=dev --silent
zip -r /tmp/pay-callback-reconciler.zip . \
  --exclude "*.env*" \
  --exclude "tests/*" \
  --exclude "*.test.js" \
  --exclude "jest.config*" \
  --exclude "Dockerfile*" \
  --exclude "*.md" \
  --exclude ".git/*" \
  --exclude "localTest*" \
  --exclude "index-test.js" \
  > /dev/null
echo "Reconciler ZIP built."

RECONCILER_ENV=$(python3 -c "
import json, os
env = {
    'PGHOST':                      os.environ['PGHOST'],
    'PGPORT':                      os.environ.get('PGPORT', '5432'),
    'PGDATABASE':                  os.environ['PGDATABASE'],
    'PGUSER':                      os.environ['PGUSER'],
    'PGPASSWORD':                  os.environ['PGPASSWORD'],
    'WEBHOOK_SQS_QUEUE_URL':       os.environ['WEBHOOK_SQS_QUEUE_URL'],
    'AWS_REGION':                  os.environ['AWS_DEFAULT_REGION'],
    'AWS_ENDPOINT_URL':            os.environ['AWS_ENDPOINT_URL'],
    'GOVUK_PAY_WEBHOOK_SECRET':    os.environ['GOVUK_PAY_WEBHOOK_SECRET'],
    'ECS_CLUSTER_ARN':             os.environ.get('ECS_CLUSTER_ARN', ''),
    'ECS_WEBHOOK_TASK_DEFINITION': os.environ.get('ECS_WEBHOOK_TASK_DEFINITION', ''),
    'NODE_ENV':                    'local',
}
print(json.dumps({'Variables': env}))
")

echo "[3/8] Registering Lambda: desnz-syeia-pay-callback-reconciler..."
if $AWS lambda get-function --function-name desnz-syeia-pay-callback-reconciler > /dev/null 2>&1; then
  echo "   (already exists — updating code + config)"
  $AWS lambda update-function-code \
    --function-name desnz-syeia-pay-callback-reconciler \
    --zip-file fileb:///tmp/pay-callback-reconciler.zip > /dev/null
  $AWS lambda update-function-configuration \
    --function-name desnz-syeia-pay-callback-reconciler \
    --environment "$RECONCILER_ENV" > /dev/null
else
  $AWS lambda create-function \
    --function-name desnz-syeia-pay-callback-reconciler \
    --runtime nodejs18.x \
    --role arn:aws:iam::000000000000:role/lambda-exec-role \
    --handler index.handler \
    --timeout 60 \
    --memory-size 512 \
    --zip-file fileb:///tmp/pay-callback-reconciler.zip \
    --environment "$RECONCILER_ENV" > /dev/null
fi
echo "desnz-syeia-pay-callback-reconciler registered."

for i in $(seq 1 12); do
  STATUS=$($AWS lambda get-function-configuration \
    --function-name desnz-syeia-pay-callback-reconciler \
    --query 'State' --output text 2>/dev/null || echo "Pending")
  [ "$STATUS" = "Active" ] && echo "   State: Active" && break
  echo "   State: $STATUS — waiting..."
  sleep 3
done

echo "[4/8] Wiring SQS (payment-webhook-queue) → reconciler Lambda..."
QUEUE_ARN=$($AWS sqs get-queue-attributes \
  --queue-url "$WEBHOOK_SQS_QUEUE_URL" \
  --attribute-names QueueArn \
  --query 'Attributes.QueueArn' \
  --output text)
$AWS lambda create-event-source-mapping \
  --function-name desnz-syeia-pay-callback-reconciler \
  --event-source-arn "$QUEUE_ARN" \
  --batch-size 10 \
  --starting-position TRIM_HORIZON \
  > /dev/null 2>&1 || echo "   (mapping already exists — skipping)"
echo "SQS → Lambda event source mapping created."

echo ""
echo "desnz-syeia-pay-callback-relay"

echo "[5/8] Building relay Lambda ZIP (TypeScript compile)..."
cp -r /lambda-src/relay /tmp/relay-build
cd /tmp/relay-build
npm install --silent

npm install --save-dev @types/pg --silent

node -e "
  const fs = require('fs');
  const p = JSON.parse(fs.readFileSync('package.json', 'utf8'));
  delete p.type;
  fs.writeFileSync('package.json', JSON.stringify(p, null, 2));
"

set +e
npx tsc \
  --outDir dist \
  --sourceMap false \
  --declaration false \
  --skipLibCheck \
  --strict false \
  --noImplicitAny false \
  --noEmitOnError false
TSC_EXIT=$?
set -e

if [ ! -d dist ] || [ -z "$(ls -A dist)" ]; then
  echo "tsc produced no output (dist/ is empty). Cannot continue."
  exit 1
fi
echo "   tsc finished (exit code: $TSC_EXIT) — JS output present in dist/"

npm prune --omit=dev --silent

cp -r node_modules dist/node_modules

cd dist
zip -r /tmp/pay-callback-relay.zip . \
  --exclude "*.env*" \
  --exclude "tests/*" \
  --exclude "*.test.js" \
  --exclude "jest.config*" \
  --exclude "Dockerfile*" \
  --exclude "*.md" \
  --exclude ".git/*" \
  > /dev/null
echo "Relay ZIP built."

RELAY_ENV=$(python3 -c "
import json, os
env = {
    'DB_HOST':          os.environ['DB_HOST'],
    'DB_PORT':          os.environ.get('DB_PORT', '5432'),
    'DB_NAME':          os.environ['DB_NAME'],
    'DB_USER':          os.environ['DB_USER'],
    'DB_PASSWORD':      os.environ['DB_PASSWORD'],
    'AWS_REGION':       os.environ['AWS_DEFAULT_REGION'],
    'AWS_ENDPOINT_URL': os.environ['AWS_ENDPOINT_URL'],
    'SQS_QUEUE_URL':    os.environ['SQS_QUEUE_URL'],
    'NODE_ENV':         'local',
}
print(json.dumps({'Variables': env}))
")

echo "[6/8] Registering Lambda: desnz-syeia-pay-callback-relay..."
if $AWS lambda get-function --function-name desnz-syeia-pay-callback-relay > /dev/null 2>&1; then
  echo "   (already exists — updating code + config)"
  $AWS lambda update-function-code \
    --function-name desnz-syeia-pay-callback-relay \
    --zip-file fileb:///tmp/pay-callback-relay.zip > /dev/null
  $AWS lambda update-function-configuration \
    --function-name desnz-syeia-pay-callback-relay \
    --environment "$RELAY_ENV" > /dev/null
else
  $AWS lambda create-function \
    --function-name desnz-syeia-pay-callback-relay \
    --runtime nodejs18.x \
    --role arn:aws:iam::000000000000:role/lambda-exec-role \
    --handler handler.handler \
    --timeout 120 \
    --memory-size 256 \
    --zip-file fileb:///tmp/pay-callback-relay.zip \
    --environment "$RELAY_ENV" > /dev/null
fi
echo "desnz-syeia-pay-callback-relay registered."

for i in $(seq 1 12); do
  STATUS=$($AWS lambda get-function-configuration \
    --function-name desnz-syeia-pay-callback-relay \
    --query 'State' --output text 2>/dev/null || echo "Pending")
  [ "$STATUS" = "Active" ] && echo "   State: Active" && break
  echo "   State: $STATUS — waiting..."
  sleep 3
done

echo "[7/8] Creating EventBridge schedule rule (every 5 minutes)..."
$AWS events put-rule \
  --name desnz-syeia-pay-callback-relay-schedule \
  --schedule-expression "rate(5 minutes)" \
  --state ENABLED \
  --description "Triggers desnz-syeia-pay-callback-relay every 5 min to poll and enqueue unenqueued webhooks" \
  > /dev/null 2>&1 || echo "   (rule already exists — skipping)"
echo "EventBridge rule created: desnz-syeia-pay-callback-relay-schedule"

echo "[8/8] Wiring EventBridge → relay Lambda..."
$AWS lambda add-permission \
  --function-name desnz-syeia-pay-callback-relay \
  --statement-id desnz-syeia-relay-eventbridge-invoke \
  --action lambda:InvokeFunction \
  --principal events.amazonaws.com \
  --source-arn "arn:aws:events:${AWS_DEFAULT_REGION}:000000000000:rule/desnz-syeia-pay-callback-relay-schedule" \
  > /dev/null 2>&1 || echo "   (permission already exists — skipping)"

$AWS events put-targets \
  --rule desnz-syeia-pay-callback-relay-schedule \
  --targets "Id=desnz-syeia-relay-target,Arn=arn:aws:lambda:${AWS_DEFAULT_REGION}:000000000000:function:desnz-syeia-pay-callback-relay" \
  > /dev/null 2>&1 || echo "   (target already wired — skipping)"
echo "EventBridge → Lambda target wired."

echo ""
echo "All Lambda registrations complete! Container will now exit."
echo ""
echo "Active flows:"
echo "payment-webhook-queue (SQS)"
echo "  → desnz-syeia-pay-callback-reconciler → processes webhook → appdb"
echo ""
echo "EventBridge (every 5 min)"
echo "  → desnz-syeia-pay-callback-relay → polls appdb for unenqueued webhooks"
echo "  → enqueues to payment-webhook-queue"
echo "  → desnz-syeia-pay-callback-reconciler picks them up"
