HOST=localhost
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=postgres
PGSSLMODE=disable

NODE_ENV=local
LOG_LEVEL=debug

BACKEND_SERVICE_URL=http://localhost:3000/backend

# GOV.UK Pay Configuration
GOVPAY_API_KEY=test-api-key-change-in-production
GOVPAY_API_URL=https://publicapi.payments.service.gov.uk/v1/payments
GOVPAY_WEBHOOK_SIGNING_KEY=test-signing-key-change-in-production

SESSION_SECRET=dev-session-secret-change-in-production

# Feature flags
CALLBACK_SERVICE_ENABLED=true
SIGNATURE_VERIFICATION_ENABLED=true


RETRY_ENABLED=true
DLQ_ENABLED=true

AWS_REGION=eu-west-2
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PAYMENT_WEBHOOK_QUEUE_URL=http://localhost:4566/000000000000/payment-webhook-queue
SQS_ENABLED=true
