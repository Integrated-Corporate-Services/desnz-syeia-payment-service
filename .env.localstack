# Environment Configuration for LocalStack Testing
# Copy this to .env to test with LocalStack

# Server
HOST=localhost
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=postgres
PGSSLMODE=disable

# Environment
NODE_ENV=local
LOG_LEVEL=debug

# Main Backend Service URL
BACKEND_SERVICE_URL=http://localhost:3000/backend

# GOV.UK Pay Webhook Signing
GOVPAY_WEBHOOK_SIGNING_KEY=your-webhook-signing-key-here

# Session
SESSION_SECRET=dev-session-secret-change-in-production

# Feature flags
CALLBACK_SERVICE_ENABLED=true
RETRY_ENABLED=true
DLQ_ENABLED=true

# AWS SQS Configuration - LocalStack
AWS_REGION=eu-west-2
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PAYMENT_WEBHOOK_QUEUE_URL=http://localhost:4566/000000000000/payment-webhook-queue
SQS_ENABLED=true
